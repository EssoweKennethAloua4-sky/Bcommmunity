{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://bakhita-api-production.up.railway.app/api/$1"
    },
    {
      "source": "/p/(.*)",
      "destination": "https://bakhita-api-production.up.railway.app/p/$1"
    },
    {
      "source": "/profil-partage/(.*)",
      "destination": "https://bakhita-api-production.up.railway.app/profil-partage/$1"
    },
    {
      "source": "/gestion-bakhita-x7/(.*)",
      "destination": "https://bakhita-api-production.up.railway.app/gestion-bakhita-x7/$1"
    },
    {
      "source": "/gestion-bakhita-x7",
      "destination": "https://bakhita-api-production.up.railway.app/gestion-bakhita-x7"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://bakhita-api-production.up.railway.app/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
